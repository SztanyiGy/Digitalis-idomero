<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.digitalisidomero.ui.SettingsController"
            fitToWidth="true"
            stylesheets="@settings.css"
            styleClass="scroll-pane">

    <VBox spacing="20" styleClass="responsive-container">
        <padding>
            <Insets top="30" bottom="30" left="40" right="40"/>
        </padding>

        <!-- Fejléc -->
        <VBox spacing="8" styleClass="card">
            <padding>
                <Insets top="25" bottom="25" left="30" right="30"/>
            </padding>
            <Label text="⚙️ Beállítások" styleClass="card-header"/>
            <Label text="Személyre szabás és beállítások" styleClass="card-subtitle"/>
        </VBox>

        <!-- IDŐZÍTŐ SZEKCIÓ -->
        <VBox spacing="15" styleClass="card">
            <padding>
                <Insets top="25" bottom="25" left="30" right="30"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="⏰" style="-fx-font-size: 24px;"/>
                <Label text="Időzítő munkafolyamathoz" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>

            <Separator/>

            <Label text="Állíts be egy időzítőt, és válaszd ki a tevékenység kategóriáját. Az időzítő alatt végzett munka automatikusan mentésre kerül."
                   style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-wrap-text: true;"/>

            <!-- Időzítő kijelző -->
            <VBox spacing="12" alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-padding: 25;">
                <Label fx:id="timerDisplayLabel" text="00:00:00" styleClass="timer-display"/>
                <Label fx:id="timerStatusLabel" text="Leállítva" styleClass="status-label, status-stopped"/>
            </VBox>

            <!-- Kategória választás -->
            <VBox spacing="10">
                <Label text="📂 Kategória kiválasztása:" style="-fx-font-size: 15px; -fx-font-weight: 600;"/>

                <HBox spacing="12" alignment="CENTER">
                    <ToggleButton fx:id="workCategoryToggle" text="💼 Munka" styleClass="category-toggle, category-work"
                                  prefWidth="150" prefHeight="45"/>
                    <ToggleButton fx:id="studyCategoryToggle" text="📚 Tanulás" styleClass="category-toggle, category-study"
                                  prefWidth="150" prefHeight="45"/>
                    <ToggleButton fx:id="entertainmentCategoryToggle" text="🎮 Szórakozás" styleClass="category-toggle, category-entertainment"
                                  prefWidth="150" prefHeight="45"/>
                </HBox>

                <Label fx:id="categoryWarningLabel" text=""
                       style="-fx-font-size: 12px; -fx-text-fill: #dc2626; -fx-font-weight: 600;" visible="false"/>
            </VBox>

            <!-- Idő beállítás -->
            <VBox spacing="10">
                <Label text="⏱️ Időtartam beállítása:" style="-fx-font-size: 15px; -fx-font-weight: 600;"/>

                <HBox spacing="15" alignment="CENTER">
                    <!-- Órák -->
                    <VBox spacing="6" alignment="CENTER">
                        <Label text="Órák" styleClass="spinner-label"/>
                        <Spinner fx:id="hoursSpinner" styleClass="time-spinner" prefWidth="90" editable="true"/>
                    </VBox>

                    <Label text=":" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                    <!-- Percek -->
                    <VBox spacing="6" alignment="CENTER">
                        <Label text="Percek" styleClass="spinner-label"/>
                        <Spinner fx:id="minutesSpinner" styleClass="time-spinner" prefWidth="90" editable="true"/>
                    </VBox>

                    <Label text=":" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                    <!-- Másodpercek -->
                    <VBox spacing="6" alignment="CENTER">
                        <Label text="Másodpercek" styleClass="spinner-label"/>
                        <Spinner fx:id="secondsSpinner" styleClass="time-spinner" prefWidth="90" editable="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Gyors preset gombok -->
            <VBox spacing="8">
                <Label text="⚡ Gyors választás:" style="-fx-font-size: 15px; -fx-font-weight: 600;"/>

                <GridPane hgap="10" vgap="10">
                    <Button text="5 perc" onAction="#setTimer5Min" styleClass="preset-button-small"
                            GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity"/>
                    <Button text="15 perc" onAction="#setTimer15Min" styleClass="preset-button-small"
                            GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                    <Button text="25 perc" onAction="#setTimer25Min" styleClass="preset-button-small"
                            GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="Infinity"/>
                    <Button text="30 perc" onAction="#setTimer30Min" styleClass="preset-button-small"
                            GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>

                    <Button text="45 perc" onAction="#setTimer45Min" styleClass="preset-button-small"
                            GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity"/>
                    <Button text="1 óra" onAction="#setTimer1Hour" styleClass="preset-button-small"
                            GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>
                    <Button text="2 óra" onAction="#setTimer2Hour" styleClass="preset-button-small"
                            GridPane.columnIndex="2" GridPane.rowIndex="1" maxWidth="Infinity"/>
                    <Button text="3 óra" onAction="#setTimer3Hour" styleClass="preset-button-small"
                            GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    </columnConstraints>
                </GridPane>
            </VBox>

            <!-- Vezérlő gombok -->
            <HBox spacing="12" alignment="CENTER">
                <padding>
                    <Insets top="10"/>
                </padding>
                <Button fx:id="startTimerButton" text="▶ Indítás" onAction="#handleStartTimer"
                        styleClass="control-button, btn-start" minWidth="130" prefHeight="45"/>
                <Button fx:id="pauseTimerButton" text="⏸ Szünet" onAction="#handlePauseTimer"
                        styleClass="control-button, btn-pause" minWidth="130" prefHeight="45" disable="true"/>
                <Button fx:id="stopTimerButton" text="⏹ Leállítás" onAction="#handleStopTimer"
                        styleClass="control-button, btn-stop" minWidth="130" prefHeight="45" disable="true"/>
            </HBox>

            <!-- Info box -->
            <VBox spacing="8" style="-fx-background-color: #dbeafe; -fx-background-radius: 10; -fx-border-color: #60a5fa; -fx-border-width: 2; -fx-border-radius: 10;">
                <padding>
                    <Insets top="15" bottom="15" left="20" right="20"/>
                </padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="ℹ️" style="-fx-font-size: 18px;"/>
                    <Label text="Hogyan működik?" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                </HBox>
                <VBox spacing="4">
                    <Label text="1. Válassz kategóriát (Munka, Tanulás vagy Szórakozás)"
                           style="-fx-font-size: 12px; -fx-text-fill: #1e3a8a;"/>
                    <Label text="2. Állítsd be az időtartamot vagy válassz a gyors gombok közül"
                           style="-fx-font-size: 12px; -fx-text-fill: #1e3a8a;"/>
                    <Label text="3. Indítsd el az időzítőt - az idő automatikusan mentésre kerül a kiválasztott kategóriába"
                           style="-fx-font-size: 12px; -fx-text-fill: #1e3a8a;"/>
                    <Label text="4. Értesítést kapsz, amikor lejár az idő"
                           style="-fx-font-size: 12px; -fx-text-fill: #1e3a8a;"/>
                </VBox>
            </VBox>

        </VBox>

    </VBox>

</ScrollPane>