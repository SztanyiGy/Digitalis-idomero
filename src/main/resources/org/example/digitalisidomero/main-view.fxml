<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.digitalisidomero.ui.MainController"
            stylesheets="@styles.css">

    <!-- BAL OLDALI SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="0">

            <!-- Logo -->
            <VBox styleClass="sidebar-header">
                <Label text="⏱️" styleClass="sidebar-logo"/>
                <Label text="Time" styleClass="sidebar-title"/>
                <Label text="Tracker" styleClass="sidebar-subtitle"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Navigáció -->
            <VBox spacing="8" style="-fx-padding: 25 12;">

                <Button fx:id="navHomeButton" onAction="#showHomePage" styleClass="nav-button, nav-button-active">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="🏠" styleClass="nav-button-icon"/>
                            <Label text="Főoldal" styleClass="nav-button-text"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="navStatsButton" onAction="#showStatisticsPage" styleClass="nav-button">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="📊" styleClass="nav-button-icon"/>
                            <Label text="Statisztika" styleClass="nav-button-text"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="navSettingsButton" onAction="#showSettingsPage" styleClass="nav-button">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="⚙️" styleClass="nav-button-icon"/>
                            <Label text="Beállítások" styleClass="nav-button-text"/>
                        </VBox>
                    </graphic>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Állapot -->
            <VBox alignment="CENTER" style="-fx-padding: 20 15 25 15;">
                <Label fx:id="statusLabel" text="Leállítva" styleClass="status-label, status-stopped"/>
            </VBox>

        </VBox>
    </left>

    <!-- TARTALOM TERÜLET -->
    <center>
        <StackPane styleClass="content-area">

            <!-- FŐOLDAL -->
            <ScrollPane fx:id="homeViewScroll" fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox fx:id="homeView" spacing="25" styleClass="responsive-container">

                    <!-- Fejléc -->
                    <VBox spacing="8" styleClass="card">
                        <Label text="Digitális Időmérő" styleClass="card-header"/>
                        <Label text="Kövesse nyomon digitális eszközhasználatát" styleClass="card-subtitle"/>
                    </VBox>

                    <!-- Vezérlők -->
                    <HBox spacing="20" alignment="CENTER" styleClass="card">
                        <Button fx:id="startButton" text="▶  Start" onAction="#handleStart" styleClass="control-button, btn-start"/>
                        <Button fx:id="pauseButton" text="⏸  Szünet" onAction="#handlePause" styleClass="control-button, btn-pause" disable="true"/>
                        <Button fx:id="stopButton" text="⏹  Stop" onAction="#handleStop" styleClass="control-button, btn-stop" disable="true"/>
                    </HBox>

                    <!-- Jelenlegi alkalmazás -->
                    <VBox spacing="18" styleClass="card">
                        <Label text="🖥️ Jelenlegi alkalmazás" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Separator/>

                        <VBox spacing="10">
                            <Label fx:id="currentAppLabel" text="Nincs aktív követés" styleClass="current-app-label"/>
                            <Label fx:id="currentAppCategoryLabel" text="" styleClass="current-app-category"/>
                        </VBox>

                        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="session-time-container">
                            <Label text="⏱️" style="-fx-font-size: 36px;"/>
                            <VBox spacing="4">
                                <Label text="Session idő" styleClass="session-time-label"/>
                                <Label fx:id="currentSessionTimeLabel" text="00:00:00" styleClass="session-time-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Mai statisztika -->
                    <GridPane hgap="20" vgap="20">
                        <VBox spacing="12" alignment="CENTER" styleClass="stat-card, stat-card-blue" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                            <Label text="📊" styleClass="stat-card-icon"/>
                            <Label text="ÖSSZES IDŐ MA" styleClass="stat-card-label" style="-fx-text-fill: #1e40af;"/>
                            <Label fx:id="todayTotalLabel" text="0ó 0p" styleClass="stat-card-value" style="-fx-text-fill: #1e3a8a;"/>
                        </VBox>

                        <VBox spacing="12" alignment="CENTER" styleClass="stat-card, stat-card-green" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                            <Label text="💼" styleClass="stat-card-icon"/>
                            <Label text="MUNKA" styleClass="stat-card-label" style="-fx-text-fill: #15803d;"/>
                            <Label fx:id="todayWorkLabel" text="0ó 0p" styleClass="stat-card-value" style="-fx-text-fill: #166534;"/>
                        </VBox>

                        <VBox spacing="12" alignment="CENTER" styleClass="stat-card, stat-card-red" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS">
                            <Label text="🎮" styleClass="stat-card-icon"/>
                            <Label text="SZÓRAKOZÁS" styleClass="stat-card-label" style="-fx-text-fill: #b91c1c;"/>
                            <Label fx:id="todayEntertainmentLabel" text="0ó 0p" styleClass="stat-card-value" style="-fx-text-fill: #991b1b;"/>
                        </VBox>

                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>

                </VBox>
            </ScrollPane>

            <!-- STATISZTIKA VIEW -->
            <VBox fx:id="statisticsView" visible="false" managed="false" style="-fx-background-color: transparent;"/>

            <!-- BEÁLLÍTÁSOK VIEW -->
            <VBox fx:id="settingsView" spacing="25" visible="false" managed="false" styleClass="responsive-container">

                <VBox spacing="8" styleClass="card">
                    <Label text="⚙️ Beállítások" styleClass="card-header"/>
                    <Label text="Személyre szabás és beállítások" styleClass="card-subtitle"/>
                </VBox>

                <VBox spacing="15" styleClass="card">
                    <Label text="🎨 Megjelenés" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <Label text="(Hamarosan)" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <VBox spacing="15" styleClass="card">
                    <Label text="🔔 Értesítések" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <Label text="(Hamarosan)" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>