<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.digitalisidomero.ui.MainController"
      spacing="15" style="-fx-background-color: #f5f6fa; -fx-padding: 25;">

    <!-- Fejléc - Modern kártya dizájn -->
    <VBox spacing="8" style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);">
        <Label text="⏱️ Digitális Időmérő" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="statusLabel" text="Állapot: Leállítva ✗"
               style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
    </VBox>

    <!-- Vezérlő gombok - Lebegő kártya -->
    <HBox spacing="12" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <Button fx:id="startButton" text="▶  Start" onAction="#handleStart"
                style="-fx-font-size: 14px; -fx-padding: 12 25; -fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 8, 0, 0, 2);"
                prefWidth="130"/>
        <Button fx:id="pauseButton" text="⏸  Szünet" onAction="#handlePause"
                style="-fx-font-size: 14px; -fx-padding: 12 25; -fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.3), 8, 0, 0, 2);"
                prefWidth="130" disable="true"/>
        <Button fx:id="stopButton" text="⏹  Stop" onAction="#handleStop"
                style="-fx-font-size: 14px; -fx-padding: 12 25; -fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.3), 8, 0, 0, 2);"
                prefWidth="130" disable="true"/>
    </HBox>

    <!-- Aktuális alkalmazás panel - Elegáns kártya -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="🖥️" style="-fx-font-size: 20px;"/>
            <Label text="Jelenlegi alkalmazás" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
        </HBox>
        <Separator style="-fx-background-color: #e5e7eb;"/>

        <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
            <Label fx:id="currentAppLabel" text="Nincs aktív követés"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <Label fx:id="currentAppCategoryLabel" text=""
                   style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #f9fafb; -fx-padding: 12; -fx-background-radius: 8;">
            <Label text="⏱️ Session idő:" style="-fx-font-size: 13px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
            <Label fx:id="currentSessionTimeLabel" text="00:00:00"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #10b981; -fx-font-family: 'Consolas', 'Monaco', monospace;"/>
        </HBox>
    </VBox>

    <!-- Mai statisztikák panel - Premium kártya -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="📊" style="-fx-font-size: 20px;"/>
            <Label text="Mai statisztikák" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
        </HBox>
        <Separator style="-fx-background-color: #e5e7eb;"/>

        <!-- Összes idő - Kiemelve -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-padding: 18; -fx-background-radius: 10;">
            <VBox spacing="3">
                <Label text="ÖSSZES IDŐ MA" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-weight: 600; letter-spacing: 1px;"/>
                <Label fx:id="todayTotalLabel" text="0ó 0p"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
        </HBox>

        <!-- Progress bar - Modern -->
        <VBox spacing="8" style="-fx-padding: 5 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Napi cél:" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                <Label text="8 óra = 100%" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
            </HBox>
            <ProgressBar fx:id="todayProgressBar" progress="0" prefWidth="550" prefHeight="12"
                         style="-fx-accent: linear-gradient(to right, #10b981, #059669); -fx-background-radius: 6; -fx-background-color: #e5e7eb;"/>
        </VBox>

        <Separator style="-fx-background-color: #e5e7eb;"/>

        <!-- Kategóriák - Színes kártyák -->
        <GridPane hgap="12" vgap="12">
            <!-- Munka -->
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0"
                  style="-fx-background-color: #eff6ff; -fx-padding: 12; -fx-background-radius: 8;">
                <Label text="💼" style="-fx-font-size: 18px;"/>
                <VBox spacing="2">
                    <Label text="Munka" style="-fx-font-size: 11px; -fx-text-fill: #1e40af; -fx-font-weight: 600;"/>
                    <Label fx:id="todayWorkLabel" text="0ó 0p" style="-fx-font-size: 15px; -fx-text-fill: #1e3a8a; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Tanulás -->
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  style="-fx-background-color: #f0fdf4; -fx-padding: 12; -fx-background-radius: 8;">
                <Label text="📚" style="-fx-font-size: 18px;"/>
                <VBox spacing="2">
                    <Label text="Tanulás" style="-fx-font-size: 11px; -fx-text-fill: #15803d; -fx-font-weight: 600;"/>
                    <Label fx:id="todayStudyLabel" text="0ó 0p" style="-fx-font-size: 15px; -fx-text-fill: #166534; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Szórakozás -->
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="0"
                  style="-fx-background-color: #fef2f2; -fx-padding: 12; -fx-background-radius: 8;">
                <Label text="🎮" style="-fx-font-size: 18px;"/>
                <VBox spacing="2">
                    <Label text="Szórakozás" style="-fx-font-size: 11px; -fx-text-fill: #b91c1c; -fx-font-weight: 600;"/>
                    <Label fx:id="todayEntertainmentLabel" text="0ó 0p" style="-fx-font-size: 15px; -fx-text-fill: #991b1b; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Közösségi média -->
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1"
                  style="-fx-background-color: #faf5ff; -fx-padding: 12; -fx-background-radius: 8;">
                <Label text="💬" style="-fx-font-size: 18px;"/>
                <VBox spacing="2">
                    <Label text="Közösségi média" style="-fx-font-size: 11px; -fx-text-fill: #7c3aed; -fx-font-weight: 600;"/>
                    <Label fx:id="todaySocialMediaLabel" text="0ó 0p" style="-fx-font-size: 15px; -fx-text-fill: #6d28d9; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </GridPane>
    </VBox>

    <!-- Akció gombok - Modern, színes -->
    <HBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <Button text="📊  Statisztikák" onAction="#handleOpenStatistics"
                style="-fx-font-size: 13px; -fx-padding: 12 28; -fx-background-color: #9b59b6; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(155,89,182,0.3), 8, 0, 0, 2);"
                prefWidth="180"/>
        <Button text="⚙️  Beállítások" onAction="#handleOpenSettings"
                style="-fx-font-size: 13px; -fx-padding: 12 28; -fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.3), 8, 0, 0, 2);"
                prefWidth="180"/>
    </HBox>

    <!-- Lábléc - Minimal -->
    <HBox alignment="CENTER" style="-fx-padding: 15 0 5 0;">
        <Label text="© 2025 Digitális Időmérő  •  v1.0"
               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
    </HBox>

</VBox>